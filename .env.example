# ==============================================================================
# TANBOX B2B Platform - Production Environment Variables Template
# ==============================================================================
# Copy this file to .env and replace all placeholders with strong random values!
# Generate random keys via: openssl rand -hex 32

NODE_ENV=production
PORT=5050

# Database Credentials
POSTGRES_USER=tanbox_db_user
POSTGRES_PASSWORD=replace_with_strong_password_minimum_24_chars
POSTGRES_DB=tanbox_db
DATABASE_URL=postgresql://tanbox_db_user:replace_with_strong_password_minimum_24_chars@postgres:5432/tanbox_db?schema=public

# Security & Authentication (minimum 64 hex characters)
JWT_SECRET=replace_with_strong_random_jwt_secret_openssl_rand_hex_64
ENCRYPTION_SECRET=replace_with_strong_random_encryption_secret_minimum_32_chars

# Bootstrap Admin Credentials (only needed if running prisma seed)
INITIAL_ADMIN_PASSWORD=replace_with_initial_admin_password_here

# Microservices & Workers (1 concurrency is ideal for 2 vCPU server)
PDF_CONCURRENCY=1

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token_from_botfather
TELEGRAM_LEADS_CHAT_ID=replace_with_telegram_leads_chat_id
TELEGRAM_ALERTS_CHAT_ID=replace_with_telegram_alerts_chat_id

# Additional Allowed CORS Origins (optional, defaults to tanbox.kz, localhost, and 185.200.86.23)
ALLOWED_ORIGINS=http://185.200.86.23,https://185.200.86.23

# SMTP Mail Server (Email OTP Registration)
SMTP_HOST=90.156.222.131
SMTP_PORT=465
SMTP_USER=no-reply@tanbox.kz
SMTP_PASS=replace_with_smtp_password
ALLOW_SELF_SIGNED_SMTP=true

# National Catalog (NKT) Integration (optional, can also be configured via Admin UI)
NATIONAL_CATALOG_BASE_URL=https://nationalcatalog.kz/gwp
NATIONAL_CATALOG_API_KEY=replace_with_national_catalog_api_key

# Freedom Pay Acquiring
FREEDOM_PAY_MERCHANT_ID=replace_with_freedom_pay_merchant_id
FREEDOM_PAY_SECRET_KEY=replace_with_freedom_pay_secret_key
FREEDOM_PAY_API_URL=https://api.freedompay.kz
FREEDOM_PAY_TEST_MODE=1

