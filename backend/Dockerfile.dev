FROM node:20-alpine

# Install OpenSSL required by Prisma Query Engine on Alpine
RUN apk add --no-cache openssl libc6-compat

WORKDIR /app

COPY package*.json ./
COPY prisma ./prisma/

RUN npm install
RUN npx prisma generate

COPY . .

EXPOSE 5050

CMD ["sh", "-c", "npx prisma db push && npm run dev"]
