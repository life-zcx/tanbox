FROM node:20-alpine

# Install OpenSSL, PostgreSQL client and Chromium for server-side PDF generation on Alpine
RUN apk add --no-cache openssl libc6-compat postgresql-client chromium nss freetype harfbuzz ca-certificates ttf-freefont font-noto

WORKDIR /app

COPY package*.json ./
COPY prisma ./prisma/

RUN npm install
RUN npx prisma generate

COPY . .

EXPOSE 5050

CMD ["sh", "-c", "npx prisma db push --accept-data-loss && npm run dev"]
