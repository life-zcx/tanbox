generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum OrderCategory {
  SHOES
  TEXTILE
  MEDICINE
  WATER
  TOBACCO
  BEER
  OILS
  DIETARY_SUPPLEMENTS
  JEWELRY
  SAIGA
  OTHER
}

enum TariffType {
  DIGITAL
  PRINT
  STANDARD
  PRO
}

enum OrderStatus {
  NEW
  PROCESSING
  PRINTING
  STICKERING
  COMPLETED
  CANCELLED
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  companyName String
  binIin      String
  phone       String
  role        Role     @default(CLIENT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders           Order[]
  stickerTemplates UserStickerTemplate[]
}

model Order {
  id             String        @id @default(uuid())
  orderNumber    String        @unique
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       OrderCategory
  tariffType     TariffType
  itemsCount     Int
  pricePerItem   Float
  totalPrice     Float
  status         OrderStatus   @default(NEW)
  extraServices         String[]      @default([])
  ssccNeeded            Boolean       @default(false)
  pdfUrl                String?
  codesFileUrl          String?
  codesFileName         String?
  stickerLayout         Json?
  stickerApprovalStatus String?       @default("IN_DESIGN")
  stickerApprovalNotes  String?
  stickerSentAt         DateTime?
  templateId            String?
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model Tariff {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  description         String
  fitFor              String
  priceRetail         Float    @default(15.0)
  priceWholesale      Float    @default(12.0)
  priceLargeWholesale Float    @default(10.0)
  costEstimate        Float    @default(3.0)
  priceMin            Float
  priceMax            Float
  marginEst           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PricingSettings {
  id                   String   @id @default(uuid())
  key                  String   @unique @default("GLOBAL")
  ssccPrice            Float    @default(5.0)
  stickerLayoutPrice   Float    @default(5000.0)
  urgentPercent        Float    @default(20.0)
  expressDeliveryPrice Float    @default(15000.0)
  volumeTier1          Int      @default(20000)
  volumeTier2          Int      @default(100000)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model ServiceLead {
  id           String     @id @default(uuid())
  serviceTitle String
  companyName  String
  phone        String
  email        String?
  binIin       String?
  notes        String?
  status       LeadStatus @default(NEW)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model LabelTemplate {
  id          String   @id @default(uuid())
  name        String
  widthMm     Float
  heightMm    Float
  description String?
  elements    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserStickerTemplate {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  category      OrderCategory?
  widthMm       Float          @default(58)
  heightMm      Float          @default(40)
  elements      Json           @default("[]")
  previewUrl    String?
  sourceOrderId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}


