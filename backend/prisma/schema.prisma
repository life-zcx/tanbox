generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum OrderCategory {
  SHOES
  TEXTILE
  MEDICINE
  WATER
  TOBACCO
  BEER
  OILS
  DIETARY_SUPPLEMENTS
  JEWELRY
  SAIGA
  OTHER
}

enum TariffType {
  DIGITAL
  PRINT
  STANDARD
  PRO
}

enum OrderStatus {
  NEW
  PROCESSING
  PRINTING
  STICKERING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
  REFUNDED
}

enum StickerApprovalStatus {
  IN_DESIGN
  WAITING_APPROVAL
  APPROVED
  CHANGES_REQUESTED
}

enum CodeItemStatus {
  NEW
  PRINTED
  REPRINTED
  DEFECTIVE
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  companyName String
  binIin      String
  phone       String
  role        Role     @default(CLIENT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders           Order[]
  stickerTemplates UserStickerTemplate[]
}

model Order {
  id                    String                @id @default(uuid())
  orderNumber           String                @unique
  userId                String
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              OrderCategory
  tariffType            TariffType
  tariff                Tariff                @relation(fields: [tariffType], references: [code])
  itemsCount            Int
  pricePerItem          Decimal               @db.Decimal(12, 2)
  totalPrice            Decimal               @db.Decimal(12, 2)
  status                OrderStatus           @default(NEW)
  extraServices         String[]              @default([])
  ssccNeeded            Boolean               @default(false)
  pdfUrl                String?
  codesFileUrl          String?
  codesFileName         String?
  stickerLayout         Json?
  stickerApprovalStatus StickerApprovalStatus @default(IN_DESIGN)
  stickerApprovalNotes  String?
  stickerSentAt         DateTime?
  templateId            String?
  template              UserStickerTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  printAllowed          Boolean               @default(false)
  paymentStatus         PaymentStatus         @default(UNPAID)
  notes                 String?
  warehouseAddress      String?
  warehouseConditions   Json?
  stickeringEstimate    Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  codeItems             OrderCodeItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderCodeItem {
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  index     Int            // 1-based sequential index within the order (1, 2, ... N)
  code      String         // Complete GS1 DataMatrix marking code
  gtin      String?
  serial    String?
  status    CodeItemStatus @default(NEW)
  printedAt DateTime?
  createdAt DateTime       @default(now())

  @@id([orderId, index])
  @@index([orderId, code])
}

model Tariff {
  id                  String     @id @default(uuid())
  code                TariffType @unique
  name                String
  description         String
  fitFor              String
  priceRetail         Decimal    @default(15.0) @db.Decimal(12, 2)
  priceWholesale      Decimal    @default(12.0) @db.Decimal(12, 2)
  priceLargeWholesale Decimal    @default(10.0) @db.Decimal(12, 2)
  costEstimate        Decimal    @default(3.0)  @db.Decimal(12, 2)
  priceMin            Decimal    @db.Decimal(12, 2)
  priceMax            Decimal    @db.Decimal(12, 2)
  marginEst           String
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  orders              Order[]
}

model PricingSettings {
  id                   String   @id @default(uuid())
  key                  String   @unique @default("GLOBAL")
  ssccPrice            Decimal  @default(5.0)     @db.Decimal(12, 2)
  stickerLayoutPrice   Decimal  @default(5000.0)  @db.Decimal(12, 2)
  urgentPercent        Decimal  @default(20.0)    @db.Decimal(12, 2)
  expressDeliveryPrice Decimal  @default(15000.0) @db.Decimal(12, 2)
  volumeTier1          Int      @default(20000)
  volumeTier2          Int      @default(100000)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model ServiceLead {
  id           String     @id @default(uuid())
  serviceTitle String
  companyName  String
  phone        String
  email        String?
  binIin       String?
  notes        String?
  status       LeadStatus @default(NEW)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model LabelTemplate {
  id          String   @id @default(uuid())
  name        String
  widthMm     Float
  heightMm    Float
  description String?
  elements    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserStickerTemplate {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  category      OrderCategory?
  widthMm       Float          @default(58)
  heightMm      Float          @default(40)
  elements      Json           @default("[]")
  previewUrl    String?
  sourceOrderId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  orders        Order[]

  @@index([userId])
}
