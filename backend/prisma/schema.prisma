generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum OrderCategory {
  SHOES
  TEXTILE
  MEDICINE
  WATER
  TOBACCO
  BEER
  OILS
  DIETARY_SUPPLEMENTS
  JEWELRY
  SAIGA
  OTHER
}

enum TariffType {
  DIGITAL
  PRINT
  STANDARD
  PRO
}

enum OrderStatus {
  NEW
  PROCESSING
  PRINTING
  STICKERING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
  REFUNDED
}

enum StickerApprovalStatus {
  IN_DESIGN
  WAITING_APPROVAL
  APPROVED
  CHANGES_REQUESTED
}

enum CodeItemStatus {
  NEW
  PRINTED
  REPRINTED
  DEFECTIVE
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  companyName String
  binIin      String
  phone       String
  role        Role     @default(CLIENT)
  isBlocked   Boolean  @default(false)
  blockedReason String?
  telegramChatId    String?   @unique
  telegramUsername  String?
  telegramAuthToken          String?   @unique
  telegramAuthTokenExpiresAt DateTime?
  telegramLinkedAt           DateTime?
  balance                    Decimal   @default(0.0) @db.Decimal(12, 2)
  tokenVersion               Int       @default(0)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  orders           Order[]
  stickerTemplates UserStickerTemplate[]
  markirovkaAccounts MarkirovkaAccount[]
  invoices         Invoice[]
  onlinePayments   OnlinePayment[]
  productCards     MarkirovkaProductCard[]
}

model Order {
  id                    String                @id @default(uuid())
  orderNumber           String                @unique
  userId                String
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              OrderCategory
  tariffType            TariffType
  tariff                Tariff                @relation(fields: [tariffType], references: [code])
  itemsCount            Int
  pricePerItem          Decimal               @db.Decimal(12, 2)
  totalPrice            Decimal               @db.Decimal(12, 2)
  status                OrderStatus           @default(NEW)
  extraServices         String[]              @default([])
  ssccNeeded            Boolean               @default(false)
  pdfUrl                String?
  codesFileUrl          String?
  codesFileName         String?
  stickerLayout         Json?
  stickerApprovalStatus StickerApprovalStatus @default(IN_DESIGN)
  stickerApprovalNotes  String?
  stickerSentAt         DateTime?
  templateId            String?
  template              UserStickerTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  printAllowed          Boolean               @default(false)
  paymentStatus         PaymentStatus         @default(UNPAID)
  notes                 String?
  warehouseAddress      String?
  warehouseConditions   Json?
  stickeringEstimate    Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  positions             OrderPosition[]
  codeItems             OrderCodeItem[]
  markirovkaOrders      MarkirovkaOrder[]
  markirovkaReports     MarkirovkaUtilisationReport[]
  invoices              Invoice[]
  onlinePayments        OnlinePayment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderPosition {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  index       Int      @default(1)
  name        String   // Наименование товара / модели
  article     String?  // Артикул
  size        String?  // Размер
  color       String?  // Цвет
  gtin        String?  // GTIN / Штрихкод (14 цифр)
  quantity    Int      @default(1) // Количество кодов для данной позиции
  customData  Json?    // Дополнительные параметры (состав, бренд, страна и т.д.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([gtin])
}

model OrderCodeItem {
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  index     Int            // 1-based sequential index within the order (1, 2, ... N)
  code      String         // Complete GS1 DataMatrix marking code
  gtin      String?
  serial    String?
  status    CodeItemStatus @default(NEW)
  printedAt DateTime?
  createdAt DateTime       @default(now())

  @@id([orderId, index])
  @@index([orderId, code])
  @@index([code])
}

model Tariff {
  id                  String     @id @default(uuid())
  code                TariffType @unique
  name                String
  description         String
  fitFor              String
  priceRetail         Decimal    @default(15.0) @db.Decimal(12, 2)
  priceWholesale      Decimal    @default(12.0) @db.Decimal(12, 2)
  priceLargeWholesale Decimal    @default(10.0) @db.Decimal(12, 2)
  costEstimate        Decimal    @default(3.0)  @db.Decimal(12, 2)
  priceMin            Decimal    @db.Decimal(12, 2)
  priceMax            Decimal    @db.Decimal(12, 2)
  marginEst           String
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  orders              Order[]
}

model PricingSettings {
  id                   String   @id @default(uuid())
  key                  String   @unique @default("GLOBAL")
  ssccPrice            Decimal  @default(5.0)     @db.Decimal(12, 2)
  stickerLayoutPrice   Decimal  @default(5000.0)  @db.Decimal(12, 2)
  selfLayoutPrice      Decimal  @default(1000.0)  @db.Decimal(12, 2)
  urgentPercent        Decimal  @default(20.0)    @db.Decimal(12, 2)
  expressDeliveryPrice Decimal  @default(15000.0) @db.Decimal(12, 2)
  volumeTier1          Int      @default(20000)
  volumeTier2          Int      @default(100000)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model ServiceLead {
  id           String     @id @default(uuid())
  serviceTitle String
  companyName  String
  phone        String
  email        String?
  binIin       String?
  notes        String?
  status       LeadStatus @default(NEW)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model LabelTemplate {
  id          String   @id @default(uuid())
  name        String
  widthMm     Float
  heightMm    Float
  description String?
  elements    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserStickerTemplate {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  category      OrderCategory?
  widthMm       Float          @default(58)
  heightMm      Float          @default(40)
  elements      Json           @default("[]")
  previewUrl    String?
  isPaid        Boolean        @default(false)
  paidAt        DateTime?
  sourceOrderId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  orders        Order[]

  @@index([userId])
}

enum MarkirovkaEnvironment {
  TEST
  PROD
}

enum MarkirovkaAccountStatus {
  ACTIVE
  AUTH_ERROR
  DISABLED
}

enum MarkirovkaOrderStatus {
  PENDING
  READY
  FETCHING
  COMPLETED
  FAILED
}

enum MarkirovkaReportStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
}

model MarkirovkaAccount {
  id                String                  @id @default(uuid())
  userId            String?
  user              User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  environment       MarkirovkaEnvironment   @default(TEST)
  baseUrl           String?
  login             String
  encryptedPassword String
  omsId             String?
  status            MarkirovkaAccountStatus @default(ACTIVE)
  token             String?                 @db.Text
  tokenExpiresAt    DateTime?
  trueApiToken      String?                 @db.Text
  trueApiExpiresAt  DateTime?
  lastCheckedAt     DateTime?
  lastError         String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  orders            MarkirovkaOrder[]
  reports           MarkirovkaUtilisationReport[]
  operations        MarkirovkaOperation[]
  productCards      MarkirovkaProductCard[]

  @@index([userId])
  @@index([environment])
}

enum MarkirovkaOperationType {
  IMPORT_NOTIFICATION
  UTILISATION
  AGGREGATION
  RETIREMENT
  VALIDATION
  CORRECTION
  DISAGGREGATION
  RETURN_TO_TURNOVER
}

enum MarkirovkaOperationStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model MarkirovkaOperation {
  id              String                    @id @default(uuid())
  type            MarkirovkaOperationType
  accountId       String?
  account         MarkirovkaAccount?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  documentNumber  String?
  codesCount      Int                       @default(0)
  status          MarkirovkaOperationStatus @default(PROCESSING)
  isSigned        Boolean                   @default(false)
  signature       String?                   @db.Text
  requestPayload  Json?
  responsePayload Json?
  errorDetails    String?
  createdById     String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([type])
  @@index([status])
  @@index([accountId])
}

model MarkirovkaOrder {
  id                String                @id @default(uuid())
  accountId         String
  account           MarkirovkaAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orderId           String?
  order             Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  externalOrderId   String?
  category          OrderCategory
  gtin              String
  quantityRequested Int
  quantityReceived  Int                   @default(0)
  status            MarkirovkaOrderStatus @default(PENDING)
  errorDetails      String?
  codes             Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([accountId])
  @@index([orderId])
  @@index([status])
}

model MarkirovkaUtilisationReport {
  id               String                 @id @default(uuid())
  accountId        String
  account          MarkirovkaAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orderId          String?
  order            Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  externalReportId String?
  category         OrderCategory
  gtin             String?
  codesCount       Int
  status           MarkirovkaReportStatus @default(DRAFT)
  reportData       Json?
  errorDetails     String?
  submittedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([accountId])
  @@index([orderId])
  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  CANCELLED
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique
  date            DateTime      @default(now())
  dueDate         DateTime?
  status          InvoiceStatus @default(PENDING)

  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  orderId         String?
  order           Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderNumber     String?

  customerName    String
  customerBinIin  String
  customerAddress String
  customerPhone   String?

  totalAmount     Decimal       @db.Decimal(12, 2)
  notes           String?

  items           InvoiceItem[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([date])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  index       Int      @default(1)
  name        String
  unit        String   @default("шт")
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  price       Decimal  @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model VerificationCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model SystemSetting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([key])
}

enum OnlinePaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum OnlinePaymentType {
  ORDER
  INVOICE
  STICKER_LAYOUT
  BALANCE
}

model OnlinePayment {
  id              String              @id @default(uuid())
  paymentNumber   String              @unique
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  orderId         String?
  order           Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  
  invoiceId       String?
  
  type            OnlinePaymentType   @default(ORDER)
  amount          Decimal             @db.Decimal(12, 2)
  currency        String              @default("KZT")
  status          OnlinePaymentStatus @default(PENDING)
  description     String
  
  pgPaymentId     String?             @unique
  pgCardPan       String?
  pgPaymentDate   DateTime?
  
  redirectUrl     String?
  rawResponse     Json?
  metadata        Json?
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

enum MarkirovkaCardStatus {
  DRAFT
  PENDING_MODERATION
  APPROVED
  REJECTED
}

model MarkirovkaProductCard {
  id                String               @id @default(uuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String?
  account           MarkirovkaAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category          OrderCategory
  name              String
  brand             String?
  article           String?
  tnved             String?
  country           String?              @default("Казахстан")
  producerName      String?
  targetGender      String?
  size              String?
  color             String?
  composition       String?
  packageType       String               @default("UNIT")
  gtin              String?
  status            MarkirovkaCardStatus @default(DRAFT)
  moderationComment String?
  nktRequestId      String?
  mptCardId         String?
  attributes        Json                 @default("{}")
  photos            String[]             @default([])
  documents         String[]             @default([])
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([gtin])
}



