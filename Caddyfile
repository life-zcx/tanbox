{
    admin off
}

# Reusable security headers snippet
(security_headers) {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }
}

# Reusable structured logging snippet with automatic rotation
(caddy_logging) {
    log {
        output file /var/log/caddy/access.log {
            roll_size 20mb
            roll_keep 5
        }
        format json
    }
}

# --- PRODUCTION DOMAINS (Automatic HTTPS / TLS via Let's Encrypt / ZeroSSL) ---

# 1. Landing (tanbox.kz, www.tanbox.kz)
tanbox.kz, www.tanbox.kz {
    import security_headers
    import caddy_logging
    encode gzip zstd

    handle /api/* {
        reverse_proxy backend:5050
    }
    handle {
        reverse_proxy frontend-landing:3000
    }
}

# 2. Client Cabinet (lk.tanbox.kz)
lk.tanbox.kz {
    import security_headers
    import caddy_logging
    encode gzip zstd

    handle /api/* {
        reverse_proxy backend:5050
    }
    handle {
        reverse_proxy frontend-lk:3001
    }
}

# 3. Admin Cabinet (admin.tanbox.kz)
admin.tanbox.kz {
    import security_headers
    import caddy_logging
    encode gzip zstd

    handle /api/* {
        reverse_proxy backend:5050
    }
    handle {
        reverse_proxy frontend-admin:3002
    }
}

# 4. Backend REST API (api.tanbox.kz)
api.tanbox.kz {
    import security_headers
    import caddy_logging
    encode gzip zstd
    reverse_proxy backend:5050
}

# --- LOCAL DEVELOPMENT & INTRANET BLOCKS (HTTP) ---

