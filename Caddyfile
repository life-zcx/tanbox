# Reusable security headers snippet
(security_headers) {
    header {
        X-Content-Type-Options "nosniff"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://*.freedompay.kz https://*.paybox.kz; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://mc.yandex.ru https://mc.yandex.com https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss://127.0.0.1:13579 wss://localhost:13579; frame-src 'self' blob: https://challenges.cloudflare.com https://www.google.com https://*.freedompay.kz https://*.paybox.kz; media-src 'self' blob:; worker-src 'self' blob:"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }
}

# Reusable structured logging snippet with automatic rotation
(caddy_logging) {
    log {
        output file /var/log/caddy/access.log {
            roll_size 20mb
            roll_keep 5
        }
        format filter {
            wrap json
            fields {
                request>uri query {
                    replace token REDACTED
                    replace access_token REDACTED
                }
            }
        }
    }
}

# --- PRODUCTION DOMAINS (Automatic HTTPS / TLS via Let's Encrypt / ZeroSSL) ---

# 1. Landing (tanbox.kz, www.tanbox.kz)
www.tanbox.kz {
    import security_headers
    import caddy_logging
    redir https://tanbox.kz{uri} permanent
}

tanbox.kz {
    import security_headers
    import caddy_logging
    encode gzip zstd

    handle /api/* {
        reverse_proxy backend:5050 {
            header_up X-Forwarded-For {client_ip}
            transport http {
                keepalive 30s
                dial_timeout 5s
            }
        }
    }
    handle /lk {
        redir https://lk.tanbox.kz/ permanent
    }
    handle_path /lk/* {
        redir https://lk.tanbox.kz{uri} permanent
    }
    handle /login {
        redir https://lk.tanbox.kz/login permanent
    }
    handle_path /login/* {
        redir https://lk.tanbox.kz/login{uri} permanent
    }
    handle /register {
        redir https://lk.tanbox.kz/register permanent
    }
    handle_path /register/* {
        redir https://lk.tanbox.kz/register{uri} permanent
    }

    # SEO 301 Redirects: consolidate alias routes to canonical primary URLs
    redir /blog /articles permanent
    redir /blog/ /articles permanent
    handle_path /blog/* {
        redir * /articles{uri} permanent
    }
    redir /kz/blog /kz/articles permanent
    redir /kz/blog/ /kz/articles permanent
    handle_path /kz/blog/* {
        redir * /kz/articles{uri} permanent
    }
    redir /en/blog /en/articles permanent
    redir /en/blog/ /en/articles permanent
    handle_path /en/blog/* {
        redir * /en/articles{uri} permanent
    }

    redir /tariffs /services permanent
    redir /tariffs/ /services permanent
    redir /kz/tariffs /kz/services permanent
    redir /kz/tariffs/ /kz/services permanent
    redir /en/tariffs /en/services permanent
    redir /en/tariffs/ /en/services permanent

    redir /payment /payment-procedure permanent
    redir /payment/ /payment-procedure permanent
    redir /payments /payment-procedure permanent
    redir /payments/ /payment-procedure permanent
    redir /kz/payment /kz/payment-procedure permanent
    redir /kz/payment/ /kz/payment-procedure permanent
    redir /kz/payments /kz/payment-procedure permanent
    redir /kz/payments/ /kz/payment-procedure permanent
    redir /en/payment /en/payment-procedure permanent
    redir /en/payment/ /en/payment-procedure permanent
    redir /en/payments /en/payment-procedure permanent
    redir /en/payments/ /en/payment-procedure permanent

    redir /cookies /cookie-policy permanent
    redir /cookies/ /cookie-policy permanent
    redir /kz/cookies /kz/cookie-policy permanent
    redir /kz/cookies/ /kz/cookie-policy permanent
    redir /en/cookies /en/cookie-policy permanent
    redir /en/cookies/ /en/cookie-policy permanent
    handle /admin {
        redir https://admin.tanbox.kz/ permanent
    }
    handle_path /admin/* {
        redir https://admin.tanbox.kz{uri} permanent
    }
    handle {
        reverse_proxy frontend-landing:3000
    }
}

# 2. Client Cabinet (lk.tanbox.kz)
lk.tanbox.kz {
    import security_headers
    import caddy_logging
    encode gzip zstd

    handle /api/* {
        reverse_proxy backend:5050 {
            header_up X-Forwarded-For {client_ip}
            transport http {
                keepalive 30s
                dial_timeout 5s
            }
        }
    }
    handle {
        reverse_proxy frontend-lk:3001
    }
}

# 3. Admin Cabinet (admin.tanbox.kz)
admin.tanbox.kz {
    import security_headers
    import caddy_logging
    encode gzip zstd

    handle /api/* {
        reverse_proxy backend:5050 {
            header_up X-Forwarded-For {client_ip}
            transport http {
                keepalive 30s
                dial_timeout 5s
            }
        }
    }
    handle {
        reverse_proxy frontend-admin:3002
    }
}

# 4. Backend REST API (api.tanbox.kz)
api.tanbox.kz {
    import security_headers
    import caddy_logging
    encode gzip zstd

    # Transparently route requests both with and without /api prefix
    @not_api not path /api/*
    rewrite @not_api /api{uri}

    reverse_proxy backend:5050 {
            header_up X-Forwarded-For {client_ip}
            transport http {
                keepalive 30s
                dial_timeout 5s
            }
        }
}

