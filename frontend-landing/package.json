    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.18",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
